# Run commands from the repository root. Relative SQLite paths use the working directory.
DATABASE_URL=sqlite:///./data/urbanagent.db
MAX_UPLOAD_BYTES=10485760
MAX_EXCEL_UNCOMPRESSED_BYTES=52428800
MAX_IMPORT_ROWS=10000

# Required only for Phase 2 classification. Add your key locally; never commit .env.
OPENAI_API_KEY=
# Set this to an OpenAI model in your account that supports Structured Outputs.
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
CLASSIFICATION_REVIEW_THRESHOLD=0.70

CATEGORIES_PATH=data/reference/categories.json
BUSINESS_RULES_PATH=data/reference/business_rules.json
